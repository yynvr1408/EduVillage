# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# LiveKit server URL (optional override, otherwise provided by backend token endpoint)
VITE_LIVEKIT_URL=wss://eduvillage-live.example.com

# Error tracking (optional). Leave unset to disable Sentry entirely; set to a real DSN from
# sentry.io to activate it with no code change.
# VITE_SENTRY_DSN=
