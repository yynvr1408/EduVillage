# Copy this file to .env in this same directory and fill in real values before
# `docker compose up -d --build`. See docs/SELF_HOSTING.md for the full guide.

# The domain this instance will be reachable at. DNS must already point here (an A/AAAA record
# to this machine's public IP) before you start Caddy, so it can get a Let's Encrypt certificate
# automatically. Use a real domain, not a bare IP — Caddy's automatic HTTPS needs one.
DOMAIN=lanterned.yourcollege.edu

# Postgres password for this instance's own database (not shared with anyone else's deployment).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-something-long-and-random

# This instance's own /admin platform-admin account — separate from the central LanternEd
# team's access; this account administers only THIS institution's deployment.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Leave blank to let teachers self-register freely on this instance; set a code to require it.
TEACHER_INVITE_CODE=

# LiveKit powers live classes. Self-hosting LiveKit's own media server needs a public IP and an
# open UDP port range, and is easy to get wrong behind a campus firewall/NAT — we recommend
# pointing this at LiveKit Cloud's free tier (https://cloud.livekit.io) even in an otherwise
# fully self-hosted deployment. See docs/SELF_HOSTING.md if you want to self-host LiveKit too.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI lecture summaries/transcription (optional — leave all blank to disable these features
# without breaking anything else).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1
SPEECH_TO_TEXT_BASE_URL=

# Email (OTP for registration and password reset) via EmailJS's REST API. Optional, but without
# it students/teachers can't verify their email or reset a forgotten password on this instance.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
