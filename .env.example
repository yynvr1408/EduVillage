# ==============================================================================
# EduVillage Environment Configuration Example
# ==============================================================================

# --- Frontend Environment Variables (in ./frontend/.env) ---
# Base URL for the EduVillage FastAPI backend service
VITE_API_BASE_URL=http://localhost:8000

# Optional LiveKit WebRTC SFU Server URL (if connecting to external mesh/cloud)
# Leave blank or set to your LiveKit Cloud / self-hosted LiveKit endpoint
VITE_LIVEKIT_URL=wss://eduvillage-live.example.com

# --- Backend Environment Variables (in ./backend/.env) ---
# Database Connection String (defaults to SQLite: sqlite:///./eduvillage.db)
DATABASE_URL=sqlite:///./eduvillage.db

# LiveKit Server API Credentials (used by FastAPI to issue scoped WebRTC tokens)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=wss://eduvillage-live.example.com

# LLM Summarization Service API Key (for background lecture note synthesis)
LLM_API_KEY=
