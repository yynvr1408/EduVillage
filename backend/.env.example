# App
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=eduvillage_session
SESSION_TTL_HOURS=72
# "lax" if frontend+API share a registrable domain; "none" if they're on unrelated domains
# (e.g. a Netlify/Vercel URL calling a Render URL) — "none" requires HTTPS on both.
SESSION_COOKIE_SAMESITE=lax

# Teacher accounts are privileged. Registering as a teacher requires this invite code.
# Leave blank in development to allow open teacher sign-up; in production blank = closed.
TEACHER_INVITE_CODE=

# Admin panel (/admin). Set BOTH to enable admin sign-in; leave blank to keep it disabled.
# Server-side only: never put these in the frontend or commit real values. The password is stored hashed (argon2).
ADMIN_USERNAME=Edu2026@
ADMIN_PASSWORD=Village@2026
# Set to true for ONE restart to change the admin password to the value above, then set it back to false.
ADMIN_RESET_PASSWORD_ON_START=false
ADMIN_SESSION_TTL_MINUTES=120

# Max upload size per file, in MB.
MAX_UPLOAD_MB=500

# Database
# Local dev default (no setup required): sqlite:///./dev.db
# Production: postgresql+psycopg2://user:password@host:5432/eduvillage
DATABASE_URL=sqlite:///./dev.db

# LiveKit (leave blank to disable classroom endpoints gracefully)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Point the LiveKit server's webhook at POST {API_BASE}/api/v1/webhooks/livekit (signed with the key above).

# Recording policy: recording is always an explicit teacher action and stays private until published.
# RECORDING_ENABLED=false is the institution-wide kill switch.
RECORDING_ENABLED=true
SIGNED_URL_TTL_SECONDS=300

# Object storage: "local" writes to backend/media (default, zero setup)
# or "s3" for an S3-compatible bucket (AWS S3 / MinIO / R2)
STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto


# AI providers (leave blank to use the clearly-labeled stub provider)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only set this if LLM_API_KEY is from an OpenAI-compatible third-party/proxy provider
# rather than real OpenAI (leave blank for real OpenAI).
LLM_BASE_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1
# Only set this if the STT key is from an OpenAI-compatible third-party provider rather than real
# OpenAI — e.g. Groq also hosts Whisper for free: SPEECH_TO_TEXT_BASE_URL=https://api.groq.com/openai/v1,
# SPEECH_TO_TEXT_MODEL=whisper-large-v3-turbo (leave blank for real OpenAI).
SPEECH_TO_TEXT_BASE_URL=

# Password-reset OTP emails via EmailJS's server-side REST API (api.emailjs.com) — called
# directly from the backend, never the browser SDK, so the OTP and its recipient stay
# server-controlled. Leave blank in development: the OTP is returned in the API response
# instead of emailed. EMAILJS_PRIVATE_KEY is the dashboard's "Private Key" (Account -> Security)
# — required once an account has "block non-browser requests" on; never put it in frontend code.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Minutes an OTP is valid for (default 5) / attempts allowed per OTP (default 5) / seconds before
# a new OTP may be requested (default 60) / minutes the post-OTP reset authorization is valid for
# (default 10). All have sane defaults; only set these to override them.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
RESET_TOKEN_TTL_MINUTES=10

# Long-recording transcription (FFmpeg must be installed; the Docker image includes it)
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=1800
STT_MAX_UPLOAD_BYTES=25165824
STT_CHUNK_SECONDS=600

# Cloudflare R2 / S3-compatible storage: OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# OBJECT_STORAGE_REGION=auto. Set OBJECT_STORAGE_FORCE_PATH_STYLE=true for emulators/self-hosted stores.
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Offline submissions made before a deadline may sync up to this many hours after it
OFFLINE_SUBMISSION_GRACE_HOURS=24
